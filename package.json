{
  "name": "@nmuzaffar/dsh-live-voice",
  "version": "0.7.4",
  "type": "module",
  "description": "Live, full-duplex voice for DeepSeek Harness: GPT-Live listens and speaks, the harness does the work.",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE",
    "assets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "scripts": {
    "test": "node --test --test-force-exit test/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nadirabid/dsh-live-voice.git"
  },
  "homepage": "https://github.com/nadirabid/dsh-live-voice#readme",
  "bugs": {
    "url": "https://github.com/nadirabid/dsh-live-voice/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "voice",
    "gpt-live",
    "realtime",
    "full-duplex"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
